WHERE product_id = 101 AND price = 50;

UPDATE PRODUCT
SET price = 900
WHERE product_id = 104 AND price = 1500;

DELETE FROM PRODUCT
WHERE product_id = 102 AND price = 200;

SELECT * FROM PRODUCT PARTITION (p_low);

